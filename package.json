{
  "name": "astro-scope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "write-env": "node scripts/write-env.js",
    "build-env": "node scripts/write-env.js",
    "build-app": "echo \"No build step required for static site.\"",
    "build": "npm run build-env && npm run build-app",
    "serve": "npx http-server -c-1 ./ -p 3000",
    "start": "npm run build && npm run serve",
    "start-server": "npm run write-env && node server.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "node-fetch": "^2.6.11",
    "body-parser": "^1.20.2"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  }
}