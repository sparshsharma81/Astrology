{
  "version": 2,
  "buildCommand": "node scripts/write-env.js",
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node@3.0.0"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}