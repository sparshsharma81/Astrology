{
  "version": 2,
  "buildCommand": "node scripts/write-env.js",
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node@3.0.0"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "outputDirectory": "."
}